{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "تشغيل C++ (مرة واحدة)",
            "type": "shell",
            "command": "g++",
            "args": [
                "-o", "tmp",
                "${file}",
                "&&", "./tmp", "&&", "rm", "tmp"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}